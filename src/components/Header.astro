---
import { getLocaleFromUrl, getSiteConfig, locales, localizePath } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const siteConfig = getSiteConfig(locale);
const otherLocale = locale === 'zh' ? 'en' : 'zh';
const currentPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';

const isActive = (href: string) => {
	const path = (Astro.url.pathname || '/').replace(/\/+$/, '') || '/';
	const h = (href || '/').replace(/\/+$/, '') || '/';
	return path === h || (h !== '/' && path.startsWith(h + '/'));
};
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-black/15 backdrop-blur-xl saturate-150" transition:name="site-header" transition:animate="none">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
		<a href="/" class="text-sm font-semibold uppercase tracking-[0.28em] text-white">
			{siteConfig.name}
		</a>
		<div class="hidden items-center gap-1 md:flex">
			{siteConfig.nav.map((item) => (
				<a
					href={item.href}
					class={`rounded-full px-3 py-2 text-sm transition hover:bg-white/10 hover:text-white ${isActive(item.href) ? 'bg-black/30 text-white font-semibold' : 'text-zinc-400'}`}
				>
					{item.label}
				</a>
			))}
		</div>
	</nav>
	<div class="flex gap-1 overflow-x-auto px-5 pb-3 md:hidden">
		{siteConfig.nav.map((item) => (
			<a href={item.href} class={`shrink-0 rounded-full px-3 py-1.5 text-sm ${isActive(item.href) ? 'bg-black/40 text-white font-semibold' : 'bg-white/5 text-zinc-300'}`}>
				{item.label}
			</a>
		))}
	</div>
</header>
